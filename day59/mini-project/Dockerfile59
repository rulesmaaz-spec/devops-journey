FROM python:3.11-slim

WORKDIR /app

# Upgrade pip, setuptools, and wheel to fix base image CVEs
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

RUN pip install --no-cache-dir --upgrade "setuptools>=78.1.1" "urllib3>=2.8.0" "msgpack>=1.2.1"

COPY requirements59.txt .
RUN pip install --no-cache-dir -r requirements59.txt

COPY app59.py .

EXPOSE 5000

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "app59:app"]
