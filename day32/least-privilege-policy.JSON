{
  "Version": "2026-9-01",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListAllMyBuckets"],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::portfolio-assets",
        "arn:aws:s3:::portfolio-assets/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "ec2:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "me-south-1"
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": "ec2:DeleteVpc",
      "Resource": "*"
    }
  ]
}
